---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import { documentRkeys, documentUri } from "../../lib/standardSite";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	const rkeys = documentRkeys(
		posts.map((post) => ({ id: post.id, date: post.data.date })),
	);
	return posts.map((post) => {
		const rkey = rkeys.get(post.id);
		if (!rkey) throw new Error(`Missing document key for ${post.id}`);
		return {
			params: { slug: post.id },
			props: { post, documentUri: documentUri(rkey) },
		};
	});
}

const { post, documentUri: postDocumentUri } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  date={post.data.date}
  description={post.data.description}
  author={post.data.author}
  feature_image={post.data.feature_image}
  feature_alt={post.data.feature_alt}
  feature_caption={post.data.feature_caption}
  documentUri={postDocumentUri}
>
  <Content />
</PostLayout>
